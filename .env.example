MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_TIMEOUT_MS=120000

PORT=3000
OCR_MAX_FILE_SIZE_MB=25
# Sunucunun localhost/private IP'lere URL indirmesine izin ver (SSRF koruması
# varsayılan olarak bunu engeller; sadece güvenilir/izole ortamlarda açın).
OCR_ALLOW_PRIVATE_URLS=false

TESSERACT_LANG=eng+tur

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30

# Varsayılan OCR profili (jde_invoice | none)
OCR_DEFAULT_PROFILE=jde_invoice

# Canlıda zorunlu — istemciye verilecek API token
# Authorization: Bearer <token>  veya  X-API-Key: <token>
API_AUTH_TOKEN=

# /api istek logları (JSON satır). Kapatmak için: false
LOG_API=true
